///|
// Assertions are a direct paint-entry/box projection of all 56 actual frames
// from run 39032334348, artifact 12100643370, CI merge 554bfe0908102375cef15efdc0ea7c15541b2621.
// raw.json SHA-256 b4fd41463d8a12da803ef04ffa37750ee25864e23a0def8e21f9528b5799fe50.
// These are expected observations only, never final geometry inputs. Tests
// execute real core layout, prepaint and scene emission, not callback emulation.
fn nested_item(id : UInt64, main : Double, cross : Double) -> @layout.FlexItem {
  @layout.FlexItem::new(
    id,
    @layout.Dimension::points(main).unwrap(),
    @layout.Dimension::points(cross).unwrap(),
    @primitives.Size::new(0, 0).unwrap(),
  )
  .with_flex(0, 0)
  .unwrap()
}

///|
fn nested_plain(id : UInt64, main : Double, cross : Double) -> @element.Element {
  @element.Element::new(nested_item(id, main, cross)).with_pointer_events(false)
}

///|
fn nested_box(id : UInt64, main : Double, cross : Double) -> @element.Element {
  nested_plain(id, main, cross)
  .with_background(Some(@primitives.Color::rgba(80, 120, 160, 255).unwrap()))
  .with_pointer_events(true)
  .with_focusable(true)
  .with_tab_stop(true)
}

///|
fn nested_outer(
  id : UInt64,
  priority : Int32,
  child_priority : Int32,
  child : Bool,
  x : Double,
  y : Double,
) -> @element.Element {
  let row = @layout.FlexTreeStyle::new(@layout.FlowDirection::row())
  let column = @layout.FlexTreeStyle::new(@layout.FlowDirection::column())
  let before = nested_plain(id + 4, 0, 72)
    .with_children_style(row)
    .with_child(nested_box(id + 1, 12, 12))
  let mut owner = nested_plain(id + 5, 0, 72)
    .with_children_style(column)
    .with_child(nested_plain(id + 6, 0, 0))
  if child {
    owner = owner.with_child(
      @element.Element::anchored_after(
        id + 7,
        id + 6,
        nested_box(id + 3, 40, 32),
        @element.TopLeft,
        @element.Local,
        @primitives.Point::new(32, 24).unwrap(),
        margin=8,
      )
      .unwrap()
      .deferred(priority=child_priority)
      .unwrap(),
    )
  }
  let after = nested_plain(id + 8, 96, 72)
    .with_children_style(
      row.with_insets(
        @layout.Insets::new(8, 0, 0, 16).unwrap(),
        @layout.Insets::zero(),
      ),
    )
    .with_child(nested_box(id + 2, 12, 12))
  let popup = nested_box(id, 96, 72)
    .with_children_style(row)
    .with_child(before)
    .with_child(owner)
    .with_child(after)
  @element.Element::anchored_after(
    id + 9,
    3,
    popup,
    @element.TopLeft,
    @element.Local,
    @primitives.Point::new(x, y).unwrap(),
    margin=8,
  )
  .unwrap()
  .deferred(priority~)
  .unwrap()
}

///|
fn nested_root(
  ap : Int32,
  anp : Int32,
  bp : Int32,
  bnp : Int32,
  child : Bool,
  moved : Bool,
) -> @element.Element {
  let row = @layout.FlexTreeStyle::new(@layout.FlowDirection::row())
  let column = @layout.FlexTreeStyle::new(@layout.FlowDirection::column())
  let parent = nested_plain(2, 0, 192)
    .with_children_style(column)
    .with_child(
      nested_plain(3, 0, 0)
      .with_children_style(row)
      .with_child(nested_box(4, 12, 12)),
    )
    .with_child(nested_outer(10, ap, anp, child, 24, 24))
    .with_child(nested_outer(30, bp, bnp, true, 144, 64))
  let after = nested_plain(6, 272, 192)
    .with_children_style(
      row.with_insets(
        @layout.Insets::new(8, 0, 0, 8).unwrap(),
        @layout.Insets::zero(),
      ),
    )
    .with_child(nested_box(5, 12, 12))
  @element.Element::root(
    1,
    row.with_insets(
      @layout.Insets::new(
        if moved {
          32
        } else {
          20
        },
        0,
        0,
        if moved {
          40
        } else {
          24
        },
      ).unwrap(),
      @layout.Insets::zero(),
    ),
  )
  .with_pointer_events(false)
  .with_child(parent)
  .with_child(after)
}

///|
fn nested_frame(
  ap : Int32,
  anp : Int32,
  bp : Int32,
  bnp : Int32,
  child : Bool,
  moved : Bool,
  scale : Double,
) -> @element.Prepainted {
  nested_root(ap, anp, bp, bnp, child, moved)
  .request_layout_with_device_scale(
    @primitives.Size::new(320, 240).unwrap(),
    scale,
  )
  .unwrap()
  .prepaint()
  .unwrap()
}

///|
fn nested_quad_ids(frame : @element.Prepainted) -> Array[UInt64] {
  frame
  .paint()
  .commands()
  .filter_map(command => {
    if command.kind() == @scene.Quad {
      Some(command.id())
    } else {
      None
    }
  })
}

///|
fn nested_assert_observation(
  ap : Int32,
  anp : Int32,
  bp : Int32,
  bnp : Int32,
  child : Bool,
  moved : Bool,
  scale : Double,
  expected : Array[(UInt64, Double, Double, Double, Double)],
) -> Unit raise {
  let frame = nested_frame(ap, anp, bp, bnp, child, moved, scale)
  assert_eq(nested_quad_ids(frame), expected.map(value => value.0))
  let viewport = @primitives.Rect::new(0, 0, 320, 240).unwrap()
  let stack : Array[UInt64] = []
  for command in frame.paint().commands() {
    match command {
      @scene.ClipPushCommand(id~, bounds~) => {
        assert_true(bounds == viewport)
        stack.push(id)
      }
      @scene.ClipPopCommand(id~) => assert_true(stack.pop() == Some(id))
      @scene.QuadCommand(id~, bounds~, ..) => {
        assert_true(stack.length() > 0)
        let matches = expected.filter(value => value.0 == id)
        assert_eq(matches.length(), 1)
        let (_, x, y, w, h) = matches[0]
        let observed = @primitives.Rect::new(x, y, w, h).unwrap()
        assert_true(bounds == observed)
        assert_true(frame.tree().node(id).unwrap().bounds() == observed)
      }
      _ => ()
    }
  }
  assert_eq(stack.length(), 0)
  assert_true(frame.paint_snapshot(scale) is Ok(_))
}

